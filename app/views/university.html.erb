<nav class="breadcrumb-nav" aria-label="Fil d’ariane">
  <ol id="breadcrumb" itemscope="" itemtype="https://schema.org/BreadcrumbList" class="breadcrumb">
    <li itemprop="itemListElement" itemscope="" itemtype="https://schema.org/ListItem" class="breadcrumb-item"><a itemprop="item" href="/"><span itemprop="name">Accueil</span></a><meta itemprop="position" content="1"></li>
    <li itemprop="itemListElement" itemscope="" itemtype="https://schema.org/ListItem" class="breadcrumb-item" aria-current="page"><span itemprop="name"><%= @university %></span><meta itemprop="position" content="2"></li>
  </ol>
</nav>

<div class="block">
  <table>
    <thead>
      <tr>
        <th>Site</th>
        <th>Statut</th>
      </tr>
    </thead>
    <tbody>
      <% @sites.each do |name| %>
        <% site = Publication::Site.new(@university, name) %>
        <tr>
          <td><a href="/<%= site.university %>/<%= site.name %>"><%= site.name %></a></td>
          <td><img src="/<%= site.university %>/<%= site.name %>/badge.svg" alt="Statut : <%= badge(site.status).first %>"></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
