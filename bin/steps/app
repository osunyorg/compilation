#!/bin/bash
# Installe les gems de l'app, sans celles de développement et de test. Lancé par bin/setup et bin/update.
set -e
cd "$(dirname "$0")/../.."

source bin/lib/as-service.sh

cd app
# Config locale (app/.bundle/config), réappliquée à chaque fois pour corriger une machine mal configurée
as_service bundle config set --local deployment true
as_service bundle config set --local without "development test"
as_service bundle install
