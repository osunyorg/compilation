#!/bin/bash
set -e
cd "$(dirname "$0")/.."

# Build tools needed for Ruby (compiled by mise) and rbnacl
sudo apt install -y build-essential curl libsodium-dev libssl-dev libyaml-dev zlib1g-dev libffi-dev libreadline-dev

# Synchronisation des sites (sync/) ; rclone est installé avec mise, en version figée (bin/steps/tools)
sudo apt install -y openssh-client rsync

# Install Mise
if [ ! -x ~/.local/bin/mise ]; then
  curl -fsSL https://mise.run | sh
  echo 'eval "$(~/.local/bin/mise activate bash)"' >> ~/.bashrc
fi
# Le .bashrc n'est pas lu par un script non interactif : on active mise pour la suite de celui-ci
export PATH="$HOME/.local/bin:$HOME/.local/share/mise/shims:$PATH"

# Install tools via Mise
bin/steps/tools

# Sinatra
## Build the app
bin/steps/app
## Install Nginx reverse proxy
sudo apt install -y nginx
if [ ! -f "/etc/nginx/sites-available/kelmscott.conf" ]; then
  sudo cp app/nginx.conf /etc/nginx/sites-available/kelmscott.conf
  sudo ln -s /etc/nginx/sites-available/kelmscott.conf /etc/nginx/sites-enabled/
  sudo sed -i -e "s/\[USER\]/${USER}/g" /etc/nginx/sites-available/kelmscott.conf
  sudo systemctl restart nginx
fi
## Install Puma systemd service
if [ ! -f "/etc/systemd/system/kelmscott-puma.service" ]; then
  sudo cp app/systemd.service /etc/systemd/system/kelmscott-puma.service
  sudo sed -i -e "s/\[USER\]/${USER}/g" /etc/systemd/system/kelmscott-puma.service
  sudo systemctl daemon-reload
  sudo systemctl enable kelmscott-puma.service
fi
## Sandbox des builds
bin/steps/sandbox
