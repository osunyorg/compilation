#!/bin/bash
# Génère la paire de clés de Kelmscott si elle n'existe pas encore, enregistre la clé publique
# de signature de l'admin Osuny si elle est passée en argument, puis affiche la clé publique
# à renseigner dans la configuration de l'admin.
# Usage : bin/configure/keys [clé publique de signature de l'admin]
set -e
cd "$(dirname "$0")/../.."
source bin/lib/as-service.sh
cd app
# Sous l'utilisateur du service, seul à devoir lire la clé privée
as_service bundle exec ruby -e '
  require "rbnacl"
  require "base64"

  key_path = "config/kelmscott.key"
  admin_key_path = "config/admin.pub"

  unless File.exist?(key_path)
    private_key = RbNaCl::PrivateKey.generate
    File.write(key_path, Base64.strict_encode64(private_key.to_bytes), perm: 0600)
  end
  if ARGV[0]
    # Vérifie que la valeur est bien une clé publique Ed25519
    RbNaCl::VerifyKey.new(Base64.strict_decode64(ARGV[0]))
    File.write(admin_key_path, ARGV[0], perm: 0644)
  end
  unless File.exist?(admin_key_path)
    warn "Clé publique de l’admin manquante : générer la clé de signature dans l’admin (bin/rails app:kelmscott:signing_key), puis relancer ~/kelmscott/bin/configure/keys <clé publique>"
  end

  private_key = RbNaCl::PrivateKey.new(Base64.strict_decode64(File.read(key_path).strip))
  puts <<~TEXT

    Dans la configuration de l’admin (config/application.yml ou variables d’environnement) :

    KELMSCOTT_PUBLIC_KEY: #{Base64.strict_encode64(private_key.public_key.to_bytes)}

    Clé privée de Kelmscott à sauvegarder hors de la machine : ~/kelmscott/app/config/kelmscott.key

  TEXT
' "$@"
