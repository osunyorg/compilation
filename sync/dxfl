#!/bin/bash
# Synchronisation vers Deuxfleurs avec dxfl (https://git.deuxfleurs.fr/Deuxfleurs/dxfl)
# Le deuxfleurs.toml du dépôt (redirections, en-têtes) est lu s'il existe.
# Exécuté dans le sandbox (sandbox/sync), avec les outils de mise dans le PATH.
#
# Le dépôt est entièrement contrôlé par le build : rien n'y est résolu ni installé.
# dxfl vient de la toolchain (root, version figée par le package-lock), sans npx,
# qui lirait le .npmrc et le node_modules du dépôt.
set -euo pipefail
: "${DXFL_BUCKET:?DXFL_BUCKET manquant}"
: "${AWS_ACCESS_KEY_ID:?AWS_ACCESS_KEY_ID manquant}"
: "${AWS_SECRET_ACCESS_KEY:?AWS_SECRET_ACCESS_KEY manquant}"

cd "$1"
/usr/local/lib/kelmscott/toolchain/node_modules/.bin/dxfl deploy "$DXFL_BUCKET" public/ --yes
