#!/bin/bash
# Synchronisation par rsync sur SSH
# La clé privée est chargée dans un ssh-agent dédié, sans être écrite sur le disque.
# Exécuté dans le sandbox (sandbox/sync).
set -euo pipefail
: "${RSYNC_HOST:?RSYNC_HOST manquant}"
: "${RSYNC_USER:?RSYNC_USER manquant}"
: "${RSYNC_PATH:?RSYNC_PATH manquant}"
: "${RSYNC_SSH_PRIVATE_KEY:?RSYNC_SSH_PRIVATE_KEY manquant}"
if [[ -n "${RSYNC_BASTION_HOST:-}" ]]; then
  : "${RSYNC_BASTION_USER:?RSYNC_BASTION_USER manquant}"
fi

eval "$(ssh-agent -s)" > /dev/null
trap 'ssh-agent -k > /dev/null' EXIT
printf '%s\n' "$RSYNC_SSH_PRIVATE_KEY" | tr -d '\r' | ssh-add - 2> /dev/null
unset RSYNC_SSH_PRIVATE_KEY

# Pas de -a : sans -l, les liens symboliques sont ignorés
rsync_args=(-rtvz --delete)
if [[ -n "${RSYNC_BASTION_HOST:-}" ]]; then
  # Mode bastion SSH
  rsync_args+=(
    -e "ssh -p ${RSYNC_PORT:-22} -o UserKnownHostsFile=/var/lib/kelmscott-sync/.ssh/known_hosts -o StrictHostKeyChecking=accept-new -v -J ${RSYNC_BASTION_USER}@${RSYNC_BASTION_HOST}:${RSYNC_BASTION_PORT:-22}"
  )
else
  # Mode SSH classique
  rsync_args+=(
    -e "ssh -p ${RSYNC_PORT:-22} -o UserKnownHostsFile=/var/lib/kelmscott-sync/.ssh/known_hosts -o StrictHostKeyChecking=accept-new -o LogLevel=ERROR" \
  )
fi
rsync_args+=(
  "$1/public/"
  "$RSYNC_USER@$RSYNC_HOST:$RSYNC_PATH/"
)
rsync "${rsync_args[@]}"
