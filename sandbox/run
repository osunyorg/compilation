#!/bin/bash
# Lance une étape de la publication d'un site dans un sandbox systemd, sans droits :
# - fetch et compile, sous kelmscott-build : elles exécutent du code du dépôt, sans les secrets ;
# - sync, sous kelmscott-sync : elle reçoit les variables du site sur l'entrée standard, sans accès aux clés.
#
# Exécuté par root : bin/steps/sandbox l'installe dans /usr/local/sbin/kelmscott-sandbox,
# seul programme que l'utilisateur du service peut lancer avec sudo.
# Il ne fait confiance à aucun de ses arguments.
#
# Usage : kelmscott-sandbox fetch UNIVERSITY SITE GIT_URL
#         kelmscott-sandbox compile UNIVERSITY SITE
#         kelmscott-sandbox sync UNIVERSITY SITE SYNC_METHOD < variables
set -euo pipefail

DATA=/srv/kelmscott
LIB=/usr/local/lib/kelmscott
# Outils installés par mise (TOOLS_DIR, TOOLS_PATH), écrit par bin/steps/sandbox
source /etc/kelmscott/sandbox.env

command="${1:-}"
university="${2:-}"
site="${3:-}"
argument="${4:-}"

fail() {
  echo "kelmscott-sandbox : $1" >&2
  exit 2
}

case "$command" in
  fetch) [[ "$argument" == https://* ]] || fail "URL invalide" ;;
  compile) ;;
  sync) [[ "$argument" =~ ^(sftp|dxfl|rsync|s3)$ ]] || fail "méthode de synchronisation invalide" ;;
  *) fail "commande inconnue" ;;
esac
# Comme valid_name? dans l'app : pas de '/', ni de nom commençant par '.'
name='^[A-Za-z0-9_-][A-Za-z0-9_.-]*$'
[[ "$university" =~ $name ]] || fail "université invalide"
[[ "$site" =~ $name ]] || fail "site invalide"

# Le dossier de l'université appartient à root : le build ne peut pas remplacer le dossier du site
# par un lien symbolique. Root ne touche jamais à l'intérieur du dossier du site.
site_dir="$DATA/sites/$university/$site"
install -d -o root -g root -m 755 "$DATA/sites/$university"
[ -d "$site_dir" ] || install -d -o kelmscott-build -g kelmscott-build -m 755 "$site_dir"

if [ "$command" = sync ]; then
  [ -d "$site_dir/repository" ] || fail "dépôt absent"
  # La synchronisation ne voit que le dépôt de son site, en lecture seule.
  # Son HOME persiste entre les publications (clés des hôtes ssh).
  user=kelmscott-sync
  specific=(
    --working-directory=/var/lib/kelmscott-sync
    --property=BindReadOnlyPaths="$site_dir/repository"
    --property=StateDirectory=kelmscott-sync
    --setenv=HOME=/var/lib/kelmscott-sync
  )
  program=("$LIB/sync" "$argument" "$site_dir/repository")
else
  # Le build ne voit que le dossier de son site, et ne peut écrire nulle part ailleurs.
  user=kelmscott-build
  specific=(
    --working-directory="$site_dir"
    --property=BindPaths="$site_dir"
    --setenv=HOME="$site_dir"
  )
  # La compilation n'a pas besoin du réseau (ni Hugo ni pagefind) : pas d'exfiltration, ni d'accès aux services locaux
  if [ "$command" = compile ]; then
    specific+=(--property=PrivateNetwork=yes)
  fi
  program=("$LIB/$command" "$site_dir/repository" "$argument")
fi

# Les autres sites, les logs et /home (donc les clés) sont masqués. Pas de gain de privilèges,
# des ressources et une durée limitées. Les processus restants sont tués à la fin.
# PrivatePIDs : chaque étape ne voit que ses propres processus. Les builds simultanés tournent sous le même
# utilisateur : sans cela, l'un pourrait atteindre les fichiers d'un autre par /proc/<pid>/root.
exec systemd-run --wait --pipe --collect --quiet \
  --uid="$user" --gid="$user" \
  "${specific[@]}" \
  --property=ProtectSystem=strict \
  --property=ProtectHome=tmpfs \
  --property=PrivatePIDs=yes \
  --property=TemporaryFileSystem="$DATA:ro" \
  --property=BindReadOnlyPaths="$TOOLS_DIR" \
  --property=PrivateTmp=yes \
  --property=PrivateDevices=yes \
  --property=NoNewPrivileges=yes \
  --property=RestrictSUIDSGID=yes \
  --property=ProtectKernelTunables=yes \
  --property=ProtectKernelModules=yes \
  --property=ProtectKernelLogs=yes \
  --property=ProtectControlGroups=yes \
  --property=LockPersonality=yes \
  --property=MemoryMax=4G \
  --property=CPUQuota=200% \
  --property=TasksMax=1024 \
  --property=RuntimeMaxSec=30min \
  --setenv=PATH="$TOOLS_PATH:/usr/local/bin:/usr/bin:/bin" \
  --setenv=LANG=C.UTF-8 \
  "${program[@]}"
